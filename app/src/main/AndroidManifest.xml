<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardBand"
        tools:targetApi="31">

        <!-- ── Splash ──────────────────────────────────────────────────────── -->

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GuardBand">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Auth ───────────────────────────────────────────────────────── -->

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.signup.SignUpAccountActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.signup.SignUpNameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.signup.SignUpContactsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.signup.SignUpConsentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Welcome: once per account, reached only from the consent step's success. -->
        <activity
            android:name=".ui.signup.WelcomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Forgot Password ────────────────────────────────────────────── -->

        <activity
            android:name=".ui.forgot.ForgotRequestActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- ── New Credentials (the reset itself, in the app) ──────────────
             The one exported Activity: Firebase's reset email links here, so
             an external click has to be able to reach it. Everything it
             trusts from that Intent goes through ResetLinkParser first.

             autoVerify makes this an App Link rather than a plain deep link,
             so Android opens the app with no disambiguation dialog. That
             depends on assetlinks.json being served from the host below;
             docs/forgot-password.md has the deploy and the SHA-256 step.

             Host and path come from manifestPlaceholders, declared once in
             app/build.gradle.kts and read by the parser as BuildConfig
             fields. They are Firebase's own default action handler on
             firebaseapp.com, because the project cannot change the
             Console's action URL. android:path, never pathPrefix: the OAuth
             redirect handler lives on the same host.

             singleTop plus onNewIntent, so a second link tapped while this
             is open replaces the code instead of stacking another copy.
        -->

        <activity
            android:name=".ui.reset.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${resetLinkHost}"
                    android:path="${resetLinkPath}" />
            </intent-filter>
        </activity>

        <!-- Reset success: reached only from ResetPasswordActivity, so not exported. -->
        <activity
            android:name=".ui.reset.ResetSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Changelog (opened from Settings) ─────────────────────────────── -->

        <activity
            android:name=".ui.changelog.ChangelogActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Loading ────────────────────────────────────────────────────── -->

        <activity
            android:name=".ui.loading.LoadingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ── Home (bottom-nav host; tabs and Settings/Notifications are Fragments) ── -->

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
