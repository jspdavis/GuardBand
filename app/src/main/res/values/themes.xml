<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Light only; dark palette is backlog. -->
    <style name="Base.Theme.GuardBand" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <!-- Explicit, so AppCompat spinners/checkboxes don't follow the black colorSecondary -->
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>

        <!-- Window (navigationBarColor deliberately left at the system default) -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/surface_bg</item>

        <!-- Font -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.GuardBand.Button</item>
        <item name="textInputStyle">@style/Widget.GuardBand.TextInputLayout</item>

        <!-- Text appearances -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.GuardBand.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.GuardBand.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.GuardBand.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.GuardBand.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.GuardBand.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.GuardBand.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.GuardBand.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.GuardBand.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.GuardBand.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.GuardBand.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.GuardBand.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.GuardBand.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.GuardBand.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.GuardBand.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.GuardBand.LabelSmall</item>
    </style>

    <style name="Theme.GuardBand" parent="Base.Theme.GuardBand" />

    <!-- Text appearances: Material3 roles with Poppins (M3 hardcodes its own font family) -->
    <style name="TextAppearance.GuardBand.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.GuardBand.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GuardBand.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/stroke_default</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.GuardBand.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <!-- Bottom navigation: checkpoint look (tint only, no M3 active-indicator pill) -->
    <style name="Widget.GuardBand.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <!-- M3 tints the background with colorSurfaceContainer; keep it plain white -->
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Settings rows: tappable label with a chevron, and the hairline between rows -->
    <style name="Widget.GuardBand.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAppearance">@style/TextAppearance.GuardBand.BodyLarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
        <item name="drawableTint">@color/text_hint</item>
    </style>

    <style name="Widget.GuardBand.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.GuardBand.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
