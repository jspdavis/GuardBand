<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. DayNight: light or dark by the phone, or by
         Settings → Display (ui/display/ThemeChoice). The colours below are
         names; values-night/colors.xml gives each its dark value. -->
    <style name="Base.Theme.GuardBand" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <!-- Explicit, so AppCompat spinners/checkboxes don't follow the black colorSecondary -->
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>

        <!-- Window (navigationBarColor deliberately left at the system default) -->
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:windowLightStatusBar">@bool/theme_light_status_bar</item>
        <item name="android:windowBackground">@color/surface_bg</item>

        <!-- Font -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.GuardBand.Button</item>
        <item name="textInputStyle">@style/Widget.GuardBand.TextInputLayout</item>

        <!-- Text appearances -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.GuardBand.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.GuardBand.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.GuardBand.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.GuardBand.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.GuardBand.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.GuardBand.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.GuardBand.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.GuardBand.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.GuardBand.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.GuardBand.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.GuardBand.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.GuardBand.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.GuardBand.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.GuardBand.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.GuardBand.LabelSmall</item>
    </style>

    <style name="Theme.GuardBand" parent="Base.Theme.GuardBand" />

    <!-- Text appearances: Material3 roles with Poppins (M3 hardcodes its own font family) -->
    <style name="TextAppearance.GuardBand.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <style name="TextAppearance.GuardBand.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>
    <!-- The Track map's credits: one step under LabelSmall's 11sp. Not
         smaller: the licence asks for a credit that is easily readable.
         DESIGN: Jul -->
    <style name="TextAppearance.GuardBand.MapAttribution" parent="TextAppearance.GuardBand.LabelSmall">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.GuardBand.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GuardBand.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/stroke_default</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.GuardBand.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <!-- Bottom navigation: checkpoint look (tint only, no M3 active-indicator pill) -->
    <style name="Widget.GuardBand.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_bg</item>
        <!-- M3 tints the background with colorSurfaceContainer; keep it the
             plain screen surface (white, or dark in dark mode) -->
        <item name="backgroundTint">@color/surface_bg</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <!-- Icons only. The menu titles stay: TalkBack reads them, and a long
             press shows them as a tooltip. -->
        <item name="labelVisibilityMode">unlabeled</item>
        <!-- M3's minimum is 80dp, sized for icon + label. With no label, 56dp,
             and no item padding so the icons sit centred. -->
        <item name="android:minHeight">56dp</item>
        <item name="itemPaddingTop">0dp</item>
        <item name="itemPaddingBottom">0dp</item>
    </style>

    <!-- Settings rows: tappable label with a chevron, and the hairline between rows.
         The chevron means "opens another GuardBand screen"; a row that does
         something else (opens a web page or a system page) is SettingsRow.Action. -->
    <style name="Widget.GuardBand.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textAppearance">@style/TextAppearance.GuardBand.BodyLarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
        <item name="drawableTint">@color/text_hint</item>
    </style>

    <!-- A settings row that acts rather than navigates: the same row with no
         chevron, since it does not lead to another screen of the app. -->
    <!-- DESIGN: Jul -->
    <style name="Widget.GuardBand.SettingsRow.Action" parent="Widget.GuardBand.SettingsRow">
        <item name="drawableEndCompat">@null</item>
    </style>

    <!-- A settings row for an irreversible action. Colour only: the geometry
         stays the plain row, so the two line up in the same list.
    -->
    <!-- DESIGN: Jul -->
    <style name="Widget.GuardBand.SettingsRow.Destructive" parent="Widget.GuardBand.SettingsRow">
        <item name="android:textColor">@color/error_red</item>
        <item name="drawableTint">@color/error_red</item>
    </style>

    <style name="Widget.GuardBand.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Sign-up wizard
         One place for the step layouts' shared look, so a restyle touches this
         file and not four layouts. Geometry here is the agreed concept; exact
         values are still Jul's.
    -->
    <!-- DESIGN: Jul -->
    <style name="Widget.GuardBand.SignUpStep" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/surface_bg</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="TextAppearance.GuardBand.SignUpTitle" parent="TextAppearance.GuardBand.HeadlineSmall">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GuardBand.SignUpSubtitle" parent="TextAppearance.GuardBand.BodySmall">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Standalone label above a field, the pattern the step layouts use
         instead of a floating hint. -->
    <style name="TextAppearance.GuardBand.SignUpFieldLabel" parent="TextAppearance.GuardBand.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.GuardBand.SignUpInput" parent="Widget.GuardBand.TextInputLayout">
        <item name="hintEnabled">false</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Widget.GuardBand.SignUpContinue" parent="Widget.GuardBand.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cornerRadius">28dp</item>

    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.GuardBand.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Map type bottom sheet dialog -->
    <style name="ThemeOverlay.GuardBand.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.GuardBand.BottomSheet.Modal</item>
    </style>

    <style name="Widget.GuardBand.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.GuardBand.SheetTop</item>
        <item name="backgroundTint">@color/surface_bg</item>
    </style>

    <!-- A bottom sheet: top corners rounded, bottom ones square against the bar. -->
    <style name="ShapeAppearance.GuardBand.SheetTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
