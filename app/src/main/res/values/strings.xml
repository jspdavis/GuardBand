    <!-- Sign Up – Consent (outside the step indicator) -->
    <string name="label_signup_consent_title">Before you finish</string>
    <string name="label_signup_consent_subtitle">One last thing, and it matters.</string>
    <!-- What the two info rows say must match the Privacy Notice: the band, not
         the phone, reports the location, and contacts are typed in, never read
         from the phone. They explain; the statement below is what is agreed to. -->
    <string name="label_signup_consent_location_title">The band\'s location</string>
    <string name="label_signup_consent_location_desc">Every alert the band sends carries its GPS position, which shows on the map. GuardBand never uses this phone\'s location.</string>
    <string name="label_signup_consent_contacts_title">Your emergency contacts</string>
    <string name="label_signup_consent_contacts_desc">The names and numbers you added are stored with your account so the band can text them. GuardBand never reads your phone\'s contacts.</string>
    <string name="label_signup_consent_statement">I have read the Privacy Notice and agree to it, I\'m 18 or older (or have a guardian\'s permission), and the person wearing the band knows and agrees to be tracked.</string>
    <string name="btn_signup_consent_privacy">Read the Privacy Notice</string>
    <!-- Not "Create account": in complete-profile mode (a new Google sign-in)
         the account already exists, and this finishes the profile instead. -->
    <string name="btn_get_started">Get started</string>

