    <!-- Band status panel. "Reporting" rather than "Online": FR-09 tracking is
         post-alert and stops after 30 minutes, so an idle band legitimately
         sends nothing. The badge says whether it is reporting right now, which
         is all the timestamp can honestly support — "Online" would read as a
         claim about the wearer. The last-seen line is the primary signal. -->
    <string name="label_track_reporting">Reporting</string>
    <string name="label_track_not_reporting">Not reporting</string>

    <!-- Anything under a minute is "just now": second-level precision is noise
         here, and "Last seen 0 seconds ago" reads badly. -->
    <string name="label_track_last_seen_just_now">Last seen just now</string>
    <plurals name="label_track_last_seen_minutes">
        <item quantity="one">Last seen %d minute ago</item>
