<?xml version="1.0" encoding="utf-8"?>
<!--
    The light palette. values-night/colors.xml redefines every colour that
    should change in dark mode, under the same names, so layouts never pick
    a mode themselves.

    white and black are literal and the same in both modes: use them only
    for what must stay white or black (text and icons on a green or dark
    button, a badge's icon). A screen, a card or a top bar is surface_bg;
    a control floating over the map is surface_elevated.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand palette -->
    <color name="brand_primary">#4E8B38</color>
    <color name="brand_primary_dark">#3D6F2C</color>
    <!-- Redesign greens (2026-10-13): pill buttons, icon tints, screen titles -->
    <color name="brand_green">#478831</color>
    <color name="brand_green_dark">#3D7D28</color>
    <color name="brand_accent">#1A1A1A</color>

    <!-- Splash -->
    <color name="splash_bg">#FFFFFF</color>
    <color name="splash_text">#1A1A1A</color>

    <!-- Surface / background -->
    <color name="surface_bg">#FFFFFF</color>
    <color name="surface_card">#F4F4F6</color>
    <color name="surface_muted">#E5E7EB</color>
    <!-- The round buttons and pills that float over the map, and the tabs'
         top buttons. White in light mode; a raised grey in dark. -->
    <color name="surface_elevated">#FFFFFF</color>
    <color name="input_bg">#FFFFFF</color>

    <!-- Strokes / dividers -->
    <color name="stroke_default">#1A1A1A</color>
    <color name="stroke_muted">#888888</color>
    <color name="divider">#E0E0E0</color>

    <!-- Text -->
    <color name="text_primary">#1A1A1A</color>
    <color name="text_secondary">#555555</color>
    <color name="text_hint">#8E8E93</color>
    <color name="text_link">#1976D2</color>

    <!-- Status / feedback -->
    <color name="error_red">#D32F2F</color>
    <color name="success_green">#4E8B38</color>

    <!-- Alert types (alert rows, Alert history) -->
    <color name="alert_panic">#D32F2F</color>
    <color name="alert_checkin">#4E8B38</color>
    <color name="alert_low_battery">#F57C00</color>
    <color name="alert_tracking">#1976D2</color>
    <!-- A panic's card: a pale red fill and a soft red outline, so a panic
         stands out from the grey cards around it. DESIGN: Jul -->
    <color name="alert_panic_container">#FDECEC</color>
    <color name="alert_panic_outline">#F2BDBD</color>

    <!-- Password rules -->
    <color name="rule_met">#4E8B38</color>
    <color name="rule_unmet">#D32F2F</color>
    <color name="rule_neutral">#8E8E93</color>

    <!-- The dark "Retry"/"Cancel" buttons (bg_retry_gradient), white text. -->
    <color name="retry_gradient_start">#000000</color>
    <color name="retry_gradient_end">#4C4444</color>

    <!-- Map credits: 70% white, so the map shows through while the text
         keeps its contrast. The same in dark mode, on purpose: the MapTiler
         logo beside them has dark lettering, so the credits and the logo
         stay light chips over the dark map, with their own dark text
         (map_attribution_text) rather than text_secondary, which turns
         light in dark mode. DESIGN: Jul (MapTiler offers a white logo) -->
    <color name="map_attribution_bg">#B3FFFFFF</color>
    <color name="map_attribution_text">#555555</color>
</resources>
