<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.signup.ConsentActivity">

    <!-- ── Center Content Container ─────────────────────────────────────── -->

    <LinearLayout
        android:id="@+id/ll_consent_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@id/cb_consent_terms"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_setVerticalBias="0.4">

        <!-- Main Title -->
        <TextView
            android:id="@+id/tv_consent_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_consent_title"
            android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
            android:textColor="#3D7D28"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_consent_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/label_consent_subtitle"
            android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ── Permission Item 1: Location Services ─────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_map_pin"
                app:tint="#3D7D28" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_perm_location_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_perm_location_title"
                    android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_perm_location_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/label_perm_location_desc"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Permission Item 2: Contacts ──────────────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_group"
                app:tint="#3D7D28" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_perm_contacts_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_perm_contacts_title"
                    android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_perm_contacts_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/label_perm_contacts_desc"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Terms & Conditions Checkbox ───────────────────────────────────── -->

    <CheckBox
        android:id="@+id/cb_consent_terms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/label_consent_checkbox"
        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
        android:textColor="@color/text_secondary"
        android:textColorLink="#3D7D28"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Bottom Action Buttons (BACK & GET STARTED) ───────────────────── -->

    <LinearLayout
        android:id="@+id/ll_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- BACK Button Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_back_button_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_consent_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_retry_gradient"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/cd_back"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp" />

        </androidx.cardview.widget.CardView>

        <!-- GET STARTED Button Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_get_started_button_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_consent_get_started"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_signup_continue"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/btn_get_started"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>