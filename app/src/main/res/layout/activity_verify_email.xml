<?xml version="1.0" encoding="utf-8"?>
<!--
    Verify email: opened by the link in Firebase's verification email, routed
    here from the reset screen's App Link. A title, one message, and at most
    two buttons. Styled like the reset success screen.
    DESIGN: Jul owns spacing, typography and colour here.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:padding="24dp"
    tools:context=".ui.verify.VerifyEmailActivity">

    <TextView
        android:id="@+id/tv_verify_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="@font/poppins_semibold"
        android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
        android:textColor="@color/brand_green"
        app:layout_constraintBottom_toTopOf="@id/tv_verify_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:ignore="UnusedAttribute"
        tools:text="@string/label_verify_title_verified" />

    <TextView
        android:id="@+id/tv_verify_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_extralight"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/progress_verify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_verify_title"
        tools:text="Your email address is verified." />

    <ProgressBar
        android:id="@+id/progress_verify"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/cd_verify_progress"
        android:indeterminateDrawable="@drawable/bg_spinner_gradient"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_verify_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_verify_message"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_verify_retry"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_retry"
        android:textAllCaps="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cv_verify_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_verify"
        tools:visibility="visible" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_verify_continue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_verify_retry">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_continue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_verify_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
