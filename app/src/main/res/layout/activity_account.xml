<?xml version="1.0" encoding="utf-8"?>
<!--
    Account information (opened from Settings): the account's details, then a
    danger zone at the very bottom holding Delete account. The danger zone is
    set apart on purpose, so the one irreversible action on the screen never
    sits among ordinary rows.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.account.AccountActivity">

    <!-- Top bar: back arrow + title. Matches fragment_settings.xml's. -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_account_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_account_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_account_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_account"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_account_top_bar">

        <LinearLayout
            android:id="@+id/ll_account_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Details: label over value, one row each. Flat and the same
                 white as the screen, like Settings' rows. -->
            <!-- DESIGN: Jul -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/ll_account_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_account_name"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_account_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="Alex Rivera" />

                    <View style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginStart="0dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_account_email"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_account_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="alexrivera@gmail.com" />

                    <View style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginStart="0dp" />

                    <!-- Email verification: status, and Resend for a password
                         account that is not verified yet. -->
                    <!-- DESIGN: Jul -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_account_verification"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_account_verification"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                            android:textColor="@color/text_primary"
                            tools:text="@string/label_account_not_verified" />

                        <Button
                            android:id="@+id/btn_account_resend_verification"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_account_resend"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_green"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_account_verification_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_account_verification_hint"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password: Change password for a password account, an empty
                 state for a Google one, and no section at all otherwise
                 (PasswordOption). Moved here from Settings on 2026-10-27. -->
            <!-- DESIGN: Jul -->

            <LinearLayout
                android:id="@+id/ll_account_password_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_account_password_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/label_account_password_section"
                    android:textAppearance="@style/TextAppearance.GuardBand.TitleMedium"
                    android:textColor="@color/text_primary"
                    tools:ignore="UnusedAttribute" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_account_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- A password account: opens ChangePasswordActivity. -->
                        <TextView
                            android:id="@+id/tv_account_change_password"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:text="@string/label_settings_change_password"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <!-- A Google account: nothing to change here, and it
                             says why. Not clickable; focusable so TalkBack
                             reads the title and the body as one. -->
                        <LinearLayout
                            android:id="@+id/ll_account_password_google"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:visibility="gone"
                            tools:visibility="gone">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_google" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_account_password_google_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_account_password_google_title"
                                    android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:id="@+id/tv_account_password_google_body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/label_account_password_google_body"
                                    android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                                    android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Danger zone: heading, explainer and the destructive row,
                 behind a red outline and well below everything else. -->
            <!-- DESIGN: Jul -->

            <TextView
                android:id="@+id/tv_account_danger_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="48dp"
                android:accessibilityHeading="true"
                android:text="@string/label_account_danger_zone"
                android:textAppearance="@style/TextAppearance.GuardBand.TitleMedium"
                android:textColor="@color/error_red"
                tools:ignore="UnusedAttribute" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_account_danger_explainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/label_account_danger_explainer"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <TextView
                        android:id="@+id/tv_account_delete"
                        style="@style/Widget.GuardBand.SettingsRow.Destructive"
                        android:text="@string/label_account_delete" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A failed or unfinished delete: a card, not a dialog, so it
                 cannot be dismissed into nothing. Retry resumes. -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_delete_failure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_account_delete_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/error_red"
                        tools:text="Your data is deleted, but your sign-in is still active. Tap Retry to finish." />

                    <!-- Log Out only once the data is gone: the deletion
                         marker keeps the deletion waiting for the next
                         sign-in, so leaving no longer strands anyone. -->
                    <!-- DESIGN: Jul -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_account_delete_log_out"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/btn_logout"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="3dp"
                            app:cardMaxElevation="6dp">

                            <Button
                                android:id="@+id/btn_account_delete_retry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_retry_gradient"
                                android:text="@string/btn_retry"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:backgroundTint="@null"
                                app:strokeWidth="0dp" />

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progress_account_delete"
                style="@style/Widget.AppCompat.ProgressBar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/cd_delete_account_progress"
                android:indeterminateDrawable="@drawable/bg_spinner_gradient"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
