<?xml version="1.0" encoding="utf-8"?>
<!--
    Account information (opened from Settings): the account's details, then a
    danger zone at the very bottom holding Delete account. The danger zone is
    set apart on purpose, so the one irreversible action on the screen never
    sits among ordinary rows.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    tools:context=".ui.account.AccountActivity">

    <!-- Top bar: back arrow + title. Matches fragment_settings.xml's. -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_account_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_account_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_account_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_account"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_account_top_bar">

        <LinearLayout
            android:id="@+id/ll_account_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Details: label over value, one row each -->
            <!-- DESIGN: Jul -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardMaxElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/ll_account_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_account_name"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_account_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="Alex Rivera" />

                    <View style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginStart="0dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_account_email"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_account_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                        android:textColor="@color/text_primary"
                        tools:text="alexrivera@gmail.com" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Danger zone: heading, explainer and the destructive row,
                 behind a red outline and well below everything else. -->
            <!-- DESIGN: Jul -->

            <TextView
                android:id="@+id/tv_account_danger_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="48dp"
                android:accessibilityHeading="true"
                android:text="@string/label_account_danger_zone"
                android:textAppearance="@style/TextAppearance.GuardBand.TitleMedium"
                android:textColor="@color/error_red"
                tools:ignore="UnusedAttribute" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_account_danger_explainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/label_account_danger_explainer"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_secondary" />

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <TextView
                        android:id="@+id/tv_account_delete"
                        style="@style/Widget.GuardBand.SettingsRow.Destructive"
                        android:text="@string/label_account_delete" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A failed or unfinished delete: a card, not a dialog, so it
                 cannot be dismissed into nothing. Retry resumes. -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_account_delete_failure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_account_delete_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/error_red"
                        tools:text="Your data is deleted, but your sign-in is still active. Tap Retry to finish." />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="3dp"
                        app:cardMaxElevation="6dp">

                        <Button
                            android:id="@+id/btn_account_delete_retry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_retry_gradient"
                            android:text="@string/btn_retry"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:backgroundTint="@null"
                            app:strokeWidth="0dp" />

                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progress_account_delete"
                style="@style/Widget.AppCompat.ProgressBar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/cd_delete_account_progress"
                android:indeterminateDrawable="@drawable/bg_spinner_gradient"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
