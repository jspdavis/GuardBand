<?xml version="1.0" encoding="utf-8"?>
<!-- One contact row (Contacts tab). Bound by ContactAdapter. -->
<!-- Interactive long-click hold support and row styling adjusted by ishi -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Avatar circle -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_item_contact_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/surface_bg"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_profile"
            app:contentPadding="10dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/text_secondary" />

        <!-- Name / relationship / phone / Emergency chip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                android:textColor="@color/text_primary"
                tools:text="Jordan Lee" />

            <TextView
                android:id="@+id/tv_item_contact_relationship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Friend" />

            <TextView
                android:id="@+id/tv_item_contact_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_hint"
                tools:text="+639171234567" />

            <!-- "Emergency" badge — visible only when isEmergency = true.
                 Uses the brand green to stand out clearly. DESIGN: Jul -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_item_contact_emergency"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_contact_emergency_tag"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/white"
                android:visibility="gone"
                app:chipBackgroundColor="@color/brand_green"
                app:chipMinHeight="24dp"
                app:chipStartPadding="8dp"
                app:chipEndPadding="8dp"
                app:chipIcon="@drawable/ic_star_filled"
                app:chipIconTint="@color/white"
                app:chipIconSize="14dp"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Star / emergency toggle -->
        <ImageButton
            android:id="@+id/ib_item_contact_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_toggle_favorite"
            android:src="@drawable/ic_star" />

        <!-- Edit: Deprecated/hidden in favor of clicking anywhere on the contact card by ishi -->
        <ImageButton
            android:id="@+id/ib_item_contact_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_edit_contact"
            android:src="@drawable/ic_edit"
            android:visibility="gone"
            app:tint="@color/text_secondary" />

        <!-- Delete -->
        <ImageButton
            android:id="@+id/ib_item_contact_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_contact"
            android:src="@drawable/ic_delete"
            app:tint="@color/rule_unmet" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
