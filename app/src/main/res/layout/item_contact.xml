<?xml version="1.0" encoding="utf-8"?>
<!-- One emergency contact (Contacts tab). Adapted from the checkpoint's item_emergency_contact.xml. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_item_contact_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/white"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_profile"
            app:contentPadding="10dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                android:textColor="@color/text_primary"
                tools:text="Jordan Lee" />

            <TextView
                android:id="@+id/tv_item_contact_relationship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary"
                tools:text="Friend" />

            <TextView
                android:id="@+id/tv_item_contact_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_hint"
                tools:text="+1-555-0101" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ib_item_contact_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_delete_contact"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
