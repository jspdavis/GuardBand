<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign-up final screen: Consent.

    Deliberately outside the step indicator: the user has finished the three
    steps and this is the commit point. Back is the BACK pill at the bottom
    rather than view_signup_step_header.

    This is where the account is actually created: createAccount() then
    finalizeSignUp(), so abandoning any earlier step leaves nothing behind.
    btn_signup_consent_create stays disabled until the box is ticked.

    Visual design from Jehan's consent mock-up (f34487b), carried onto this
    screen so the one that records consent is the one that looks right.
-->
<!-- DESIGN: Jul -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.signup.SignUpConsentActivity">

    <!-- Scrolls only when it has to (large font scale, small screen); otherwise
         fillViewport keeps the content centred and the checkbox at the bottom. -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/ll_signup_consent_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp">

            <!-- ── Centre content ───────────────────────────────────────── -->

            <LinearLayout
                android:id="@+id/ll_signup_consent_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/progress_signup_consent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4">

                <TextView
                    android:id="@+id/tv_signup_consent_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_signup_consent_title"
                    android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
                    android:textColor="@color/brand_green_dark"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_signup_consent_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_signup_consent_subtitle"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Info row 1: the band's location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/brand_green_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_signup_consent_location_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_signup_consent_location_title"
                            android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_signup_consent_location_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/label_signup_consent_location_desc"
                            android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Info row 2: emergency contacts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_group"
                        app:tint="@color/brand_green_dark" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_signup_consent_contacts_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_signup_consent_contacts_title"
                            android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_signup_consent_contacts_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/label_signup_consent_contacts_desc"
                            android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_signup_consent"
                style="@style/Widget.AppCompat.ProgressBar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:indeterminateDrawable="@drawable/bg_spinner_gradient"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/cb_signup_consent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible" />

            <!-- The statement is the checkbox's own label, so tapping the text
                 toggles it and TalkBack reads the two as one control.
                 The statement stays plain text and the link is the separate
                 button below it. A ClickableSpan inside a checkbox label fights
                 the toggle (a tap on the link would also tick the box, or not,
                 depending on where exactly it landed) and costs the
                 single-control reading above. -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_signup_consent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:text="@string/label_signup_consent_statement"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@id/btn_signup_consent_privacy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- The notice itself, opened in the browser. A hosted page rather
                 than an in-app screen, so somebody who has uninstalled GuardBand
                 can still read what they agreed to. Its URL is
                 HostedPages.privacyNotice. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup_consent_privacy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_signup_consent_privacy"
                android:textColor="@color/brand_green_dark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- ── Bottom buttons: BACK and GET STARTED ─────────────────────────── -->

    <LinearLayout
        android:id="@+id/ll_signup_consent_buttons"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_signup_consent_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_retry_gradient"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/cd_back"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp" />
        </androidx.cardview.widget.CardView>

        <!-- Create and Retry share this slot: render() shows exactly one.
             Retry resumes at the write, so a failed profile write never
             re-creates the account. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_signup_consent_create"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardMaxElevation="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup_consent_create"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_signup_continue"
                android:enabled="false"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/btn_get_started"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup_consent_retry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_signup_continue"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/btn_alert_retry"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:strokeWidth="0dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
