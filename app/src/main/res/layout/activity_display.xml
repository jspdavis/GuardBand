<?xml version="1.0" encoding="utf-8"?>
<!--
    Display (opened from its row in Settings): the app's theme, as three
    radio options. The shared top bar, on the screen's own surface.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.display.DisplayActivity">

    <!-- Top bar: back arrow + title. Matches fragment_settings.xml's. -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_display_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_display_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_display_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_display"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_display_top_bar">

        <!-- The same side margins as Settings' rows (16 + 12 dp). DESIGN: Jul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_display_theme_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:accessibilityHeading="true"
                android:text="@string/label_display_theme"
                android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
                android:textColor="@color/text_secondary"
                tools:ignore="UnusedAttribute" />

            <RadioGroup
                android:id="@+id/rg_display_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_display_theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_extralight"
                    android:minHeight="56dp"
                    android:text="@string/label_display_theme_system"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_display_theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_extralight"
                    android:minHeight="56dp"
                    android:text="@string/label_display_theme_light"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_display_theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_extralight"
                    android:minHeight="56dp"
                    android:text="@string/label_display_theme_dark"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_display_theme_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_display_theme_help"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
