<?xml version="1.0" encoding="utf-8"?>
<!-- Track tab. A CoordinatorLayout so the recent-alerts panel can be a
     draggable bottom sheet (BottomSheetBehavior) over the map. It has an id
     so it saves the sheet's state, collapsed or expanded, across a restore. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.track.TrackFragment">

    <!-- DESIGN: Jul — spacing and colours are placeholders. Every view below
         uses theme tokens only. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Map: fills the whole tab ───────────────────────────────────── -->
        <!-- Drawn first so the buttons and the sheet sit on top of it.
             OsmdroidConfig must run before this is inflated, which is why the
             Fragment applies it in onCreate. -->

        <org.osmdroid.views.MapView
            android:id="@+id/track_map_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The strip the collapsed sheet covers. Nothing is drawn here; the
             empty overlay and the controls stack on its top edge so the
             collapsed sheet never hides them. -->
        <Space
            android:id="@+id/space_track_sheet_peek"
            android:layout_width="0dp"
            android:layout_height="@dimen/track_sheet_peek_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Shown instead of a marker when there is no position: the band has
             never reported, it has reported with no fix, or the read failed. -->

        <TextView
            android:id="@+id/track_empty_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_pill"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:drawableTint="@color/text_hint"
            app:drawableTopCompat="@drawable/ic_map"
            app:layout_constraintBottom_toTopOf="@id/space_track_sheet_peek"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/label_track_no_fix"
            tools:visibility="visible" />

        <!-- ── Top bar: settings · notifications ──────────────────────────
             The same pair, in the same places, as the Contacts and Profile
             tabs: gear top-left, bell top-right. -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ib_track_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/cd_open_settings"
            android:src="@drawable/ic_settings"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:fabCustomSize="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/brand_green" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ib_track_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/cd_open_notifications"
            android:src="@drawable/ic_notifications"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:fabCustomSize="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/brand_green" />

        <!-- ── Round map controls ─────────────────────────────────────────── -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/track_layers_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_map_layers"
            android:src="@drawable/ic_layers"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            app:layout_constraintBottom_toTopOf="@id/track_navigate_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/brand_green" />

        <!-- Navigate (D6): a tap opens a maps app on the band's position, a
             long-press re-centres the map and resumes following (D4).
             Disabled with no fix; the icon tint greys out then. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/track_navigate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/cd_track_navigate"
            android:enabled="false"
            android:src="@drawable/ic_navigation"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            app:layout_constraintBottom_toTopOf="@id/track_checkin_pill"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/map_control_icon" />

        <!-- Check-in pill (FR-10): the wearer's latest check-in, read-only.
             A TextView rather than a Button, so it is not clickable, has no
             ripple and TalkBack reads it as text, not as a control. Check-ins
             come from the band; the app never sends one.
             DESIGN: Jul (white status pill, as a placeholder) -->
        <TextView
            android:id="@+id/track_checkin_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:drawablePadding="8dp"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:text="@string/label_track_checkin_loading"
            android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
            android:textColor="@color/text_primary"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="@color/alert_checkin"
            app:layout_constraintBottom_toTopOf="@id/track_map_attribution"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Map credits (MapTiler's terms): "© MapTiler © OpenStreetMap
             contributors", each a link, bottom right, just above the strip
             the collapsed sheet covers so it stays visible. Bound by
             ui/track/MapAttribution: shown when the map opens, then
             collapsed to the ⓘ below after 5 s or the first pan (the OSMF
             attribution guidelines' rule); the ⓘ brings it back. Collapsed
             it is INVISIBLE, not GONE, so its fixed-height row keeps the
             check-in pill in place. MapTiler's Free plan also wants its logo
             bottom left; not added yet (docs/osmdroid.md).
             DESIGN: Jul (size and background are placeholders) -->
        <TextView
            android:id="@+id/track_map_attribution"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/track_map_attribution_height"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/map_attribution_bg"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textAppearance="@style/TextAppearance.GuardBand.MapAttribution"
            android:textColor="@color/text_secondary"
            android:textColorLink="@color/text_secondary"
            app:layout_constraintBottom_toTopOf="@id/space_track_sheet_peek"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="© MapTiler © OpenStreetMap contributors" />

        <!-- The collapsed credits: a small ⓘ on a see-through disc, in the
             same corner. The button is 40dp so it is easier to hit than the
             24dp disc it draws. Hidden while the credits show.
             DESIGN: Jul -->
        <ImageButton
            android:id="@+id/track_map_attribution_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_map_attribution_info"
            android:contentDescription="@string/cd_track_map_credits"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/track_map_attribution"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/text_secondary" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Recent alerts: a draggable bottom sheet over the map ──────────
         Collapsed, it shows only its handle and its header;
         dragged up (or its handle tapped) it shows the newest three. See all
         opens the full history. Not hideable, so it can always be dragged
         back. Bound by ui/track/RecentAlertsPanel.
         DESIGN: Jul -->
    <include
        android:id="@+id/track_recent_alerts_panel"
        layout="@layout/view_track_recent_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/track_sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
