<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.track.TrackFragment">

    <!-- DESIGN: Jul — spacing and colours are placeholders. Every view below
         uses theme tokens only. -->

    <!-- ── Map: fills everything under the top bar ──────────────────────── -->
    <!-- Drawn first so the chip and controls sit on top of it.
         OsmdroidConfig must run before this is inflated, which is why the
         Fragment applies it in onCreate. -->

    <org.osmdroid.views.MapView
        android:id="@+id/track_map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shown instead of a marker when there is no position: the band has
         never reported, it has reported with no fix, or the read failed. -->

    <TextView
        android:id="@+id/track_empty_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:drawableTint="@color/text_hint"
        app:drawableTopCompat="@drawable/ic_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/label_track_no_fix"
        tools:visibility="visible" />

    <!-- ── Top bar: avatar · bell · gear ──────────────────────────────────
         The avatar shows the Google profile photo when there is one (loaded
         by ui/avatar/AvatarImage) and ic_profile otherwise; the tint
         and contentPadding below apply to the icon only. The user's name is
         its content description, not visible text. -->

    <LinearLayout
        android:id="@+id/ll_track_user_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/ib_track_notifications"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_track_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/surface_card"
            android:contentDescription="@string/cd_user_avatar"
            android:src="@drawable/ic_profile"
            app:contentPadding="6dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/brand_green" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_track_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/cd_open_notifications"
        android:src="@drawable/ic_notifications"
        app:backgroundTint="@color/white"
        app:fabCustomSize="40dp"
        app:layout_constraintBottom_toBottomOf="@id/ll_track_user_chip"
        app:layout_constraintEnd_toStartOf="@id/ib_track_settings"
        app:layout_constraintTop_toTopOf="@id/ll_track_user_chip"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/brand_green" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_track_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/cd_open_settings"
        android:src="@drawable/ic_settings"
        app:backgroundTint="@color/white"
        app:fabCustomSize="40dp"
        app:layout_constraintBottom_toBottomOf="@id/ll_track_user_chip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ll_track_user_chip"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/brand_green" />

    <!-- ── Round map controls ───────────────────────────────────────────── -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/track_layers_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/cd_map_layers"
        android:src="@drawable/ic_layers"
        app:backgroundTint="@color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/track_recenter_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/brand_green" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/track_recenter_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/cd_map_recenter"
        android:src="@drawable/ic_navigation"
        app:backgroundTint="@color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/track_navigate_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/brand_green" />

    <!-- ── Bottom actions ───────────────────────────────────────────────── -->
    <!-- Navigate is filled white, like the round controls above it, so it
         stays readable over the map tiles. DESIGN: Jul -->

    <Button
        android:id="@+id/track_navigate_button"
        style="@style/Widget.GuardBand.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        android:text="@string/btn_track_navigate"
        app:backgroundTint="@color/white"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_navigation"
        app:iconTint="@color/brand_green"
        app:layout_constraintBottom_toTopOf="@id/track_checkin_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Check-in pill (FR-10): the wearer's latest check-in, read-only.
         A TextView rather than a Button, so it is not clickable, has no
         ripple and TalkBack reads it as text, not as a control. Check-ins
         come from the band; the app never sends one.
         DESIGN: Jul (white status pill like the user chip, as a placeholder) -->
    <TextView
        android:id="@+id/track_checkin_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="8dp"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp"
        android:text="@string/label_track_checkin_loading"
        android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
        android:textColor="@color/text_primary"
        app:drawableStartCompat="@drawable/ic_check_circle"
        app:drawableTint="@color/alert_checkin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>