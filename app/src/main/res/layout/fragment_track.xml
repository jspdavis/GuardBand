<?xml version="1.0" encoding="utf-8"?>
<!-- Track tab. A CoordinatorLayout so the recent-alerts panel can be a
     draggable bottom sheet (BottomSheetBehavior) over the map. It has an id
     so it saves the sheet's state, collapsed or expanded, across a restore. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.track.TrackFragment">

    <!-- DESIGN: Jul — spacing and colours are placeholders. Every view below
         uses theme tokens only. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Map: fills the whole tab ───────────────────────────────────── -->
        <!-- Drawn first so the buttons and the sheet sit on top of it.
             OsmdroidConfig must run before this is inflated, which is why the
             Fragment applies it in onCreate. -->

        <org.osmdroid.views.MapView
            android:id="@+id/track_map_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The strip the collapsed sheet covers. Nothing is drawn here; the
             empty overlay and the controls stack on its top edge so the
             collapsed sheet never hides them. -->
        <Space
            android:id="@+id/space_track_sheet_peek"
            android:layout_width="0dp"
            android:layout_height="@dimen/track_sheet_peek_height"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Shown instead of a marker when there is no position: the band has
             never reported, it has reported with no fix, or the read failed. -->

        <TextView
            android:id="@+id/track_empty_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_pill"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp"
            android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            app:drawableTint="@color/text_hint"
            app:drawableTopCompat="@drawable/ic_map"
            app:layout_constraintBottom_toTopOf="@id/space_track_sheet_peek"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/label_track_no_fix"
            tools:visibility="visible" />

        <!-- ── Top bar: settings · notifications ──────────────────────────
             The same pair as the Contacts and Device tabs: gear top-left,
             bell top-right, 36dp like the map controls and 16dp from the
             sides so the bell lines up with Layers and Navigate below it.
             Contacts and Profile match since 2026-10-20. DESIGN: Jul -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ib_track_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/cd_open_settings"
            android:src="@drawable/ic_settings"
            app:backgroundTint="@color/brand_primary_dark"
            app:elevation="4dp"
            app:fabCustomSize="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ib_track_notifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/cd_open_notifications"
            android:src="@drawable/ic_notifications"
            app:backgroundTint="@color/brand_primary_dark"
            app:elevation="4dp"
            app:fabCustomSize="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/white" />

        <!-- ── Round map controls ─────────────────────────────────────────── -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/track_layers_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/cd_map_layers"
            android:src="@drawable/ic_layers"
            app:backgroundTint="@color/brand_primary_dark"
            app:fabCustomSize="36dp"
            app:layout_constraintBottom_toTopOf="@id/track_navigate_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/white" />

        <!-- Re-centre (D4): a tap takes the map back to the band's last known
             position, zooms back in if zoomed far out, and resumes following.
             Disabled with no fix; the icon tint greys out then. The id is
             from when it was Navigate (it opened Google Maps until 2026-10-27). -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/track_navigate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/cd_track_navigate"
            android:enabled="false"
            android:src="@drawable/ic_my_location"
            app:backgroundTint="@color/brand_primary_dark"
            app:fabCustomSize="36dp"
            app:layout_constraintBottom_toTopOf="@id/card_track_checkin"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/white" />

        <!-- Dedicated tracker / last check-in status card container - styled by ishi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_track_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/stroke_default"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toTopOf="@id/barrier_track_credits"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <!-- Dedicated visual status indicator element for the last check-in state - added by ishi -->
                <FrameLayout
                    android:id="@+id/fl_track_checkin_indicator"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_alert_type_badge">

                    <!-- Visual status indicator dot / icon -->
                    <ImageView
                        android:id="@+id/iv_track_checkin_status"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/alert_checkin" />
                </FrameLayout>

                <!-- Check-in label & timestamp/time container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dedicated status label -->
                    <TextView
                        android:id="@+id/tv_track_checkin_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/label_track_checkin_header"
                        android:textAppearance="@style/TextAppearance.GuardBand.LabelSmall"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- Corresponding timestamp/time display -->
                    <TextView
                        android:id="@+id/track_checkin_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="@string/label_track_checkin_loading"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The room the 48dp ⓘ needs above the logo's 24dp row. Nothing is
             drawn here. -->
        <Space
            android:id="@+id/space_track_credit_clearance"
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toTopOf="@id/track_map_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Whichever is higher: that room, or the top of the credits. The
             credits are INVISIBLE when collapsed, never GONE, so the barrier,
             and the pill on it, do not move when they collapse. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_track_credits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="space_track_credit_clearance,track_map_attribution" />

        <!-- Map credits (MapTiler's terms): "© MapTiler © OpenStreetMap
             contributors", each a link, bottom right, just above the strip
             the collapsed sheet covers so it stays visible. Bound by
             ui/track/MapAttribution: shown when the map opens, then
             collapsed to the ⓘ below after 5 s or the first pan (the OSMF
             attribution guidelines' rule); the ⓘ brings it back. Collapsed
             it is INVISIBLE, not GONE, so nothing anchored near it moves.
             The MapTiler logo shares the row, bottom left
             (track_map_logo, below). This is the line's place when it fits
             beside the logo; when it does not (a narrow screen, a large
             system font), MapAttribution moves it onto a line of its own
             above the logo before the first draw, wrapping if even that line
             is too narrow. The ⓘ anchors to the logo; the pill to
             barrier_track_credits.
             DESIGN: Jul (size and background are placeholders) -->
        <TextView
            android:id="@+id/track_map_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/track_map_attribution_height"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/map_attribution_bg"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textAppearance="@style/TextAppearance.GuardBand.MapAttribution"
            android:textColor="@color/map_attribution_text"
            android:textColorLink="@color/map_attribution_text"
            app:layout_constraintBottom_toTopOf="@id/space_track_sheet_peek"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="© MapTiler © OpenStreetMap contributors" />

        <!-- MapTiler's logo, which the Free plan requires: bottom left, in the
             credits' row, linked to maptiler.com (MapAttribution binds the
             tap). Always visible: unlike the credits it never collapses.
             20dp tall inside the row's 2dp padding, width from the aspect
             ratio; never stretched or tinted. Transparent, straight on the
             map with no chip behind it (2026-10-27): TrackFragment swaps in
             logo_maptiler_white on a dark style (Streets Dark, Satellite).
             DESIGN: Jul -->
        <ImageView
            android:id="@+id/track_map_logo"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/track_map_attribution_height"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/cd_track_map_logo"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_maptiler"
            app:layout_constraintBottom_toTopOf="@id/space_track_sheet_peek"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- The collapsed credits: a small ⓘ on a see-through disc, in the
             same corner. The button is 48dp, the minimum touch target, around
             the 24dp disc it draws. Hidden while the credits show.
             DESIGN: Jul -->
        <ImageButton
            android:id="@+id/track_map_attribution_info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_map_attribution_info"
            android:contentDescription="@string/cd_track_map_credits"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/track_map_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/map_attribution_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Recent alerts: a draggable bottom sheet over the map ──────────
         Collapsed, it shows only its handle and its header;
         dragged up (or its handle tapped) it shows the newest three. See all
         opens the full history. Not hideable, so it can always be dragged
         back. Bound by ui/track/RecentAlertsPanel.
         DESIGN: Jul -->
    <include
        android:id="@+id/track_recent_alerts_panel"
        layout="@layout/view_track_recent_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/track_sheet_peek_height"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
