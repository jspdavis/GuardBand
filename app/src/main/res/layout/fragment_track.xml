<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.track.TrackFragment">

    <!-- ── Top bar: user chip · bell · gear ─────────────────────────────── -->

    <LinearLayout
        android:id="@+id/ll_track_user_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toStartOf="@id/ib_track_notifications"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_track_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/surface_card"
            android:contentDescription="@string/cd_user_avatar"
            android:src="@drawable/ic_profile"
            app:contentPadding="6dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
            app:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                android:textColor="@color/text_primary"
                tools:text="Alex Rivera" />

        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/ib_track_notifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_open_notifications"
        android:src="@drawable/ic_notifications"
        app:layout_constraintBottom_toBottomOf="@id/ll_track_user_chip"
        app:layout_constraintEnd_toStartOf="@id/ib_track_settings"
        app:layout_constraintTop_toTopOf="@id/ll_track_user_chip"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/ib_track_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_open_settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintBottom_toBottomOf="@id/ll_track_user_chip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ll_track_user_chip"
        app:tint="@color/text_primary" />

    <!-- ── Map placeholder ───────────────────────────────────────────────── -->

    <TextView
        android:id="@+id/tv_track_map_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/surface_muted"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:text="@string/label_track_map_placeholder"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:drawableTint="@color/text_hint"
        app:drawableTopCompat="@drawable/ic_map"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_track_user_chip" />

    <!-- Device status pill (static until the Alert data drives it) -->
    <TextView
        android:id="@+id/tv_track_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pill"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/label_track_status"
        android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
        android:textColor="@color/text_primary"
        app:drawableStartCompat="@drawable/bg_status_dot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_track_map_placeholder" />

    <!-- ── Round map controls (UI only) ──────────────────────────────────── -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_track_layers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/cd_map_layers"
        android:src="@drawable/ic_layers"
        app:backgroundTint="@color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/fab_track_recenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/text_primary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_track_recenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/cd_map_recenter"
        android:src="@drawable/ic_navigation"
        app:backgroundTint="@color/white"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@id/btn_track_check_in"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="@color/text_primary" />

    <!-- ── Check-in pill (UI only; FR-10 check-in is a band double-press) ── -->

    <Button
        android:id="@+id/btn_track_check_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        android:text="@string/btn_check_in"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_check_circle"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
