<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:padding="24dp"
    tools:context=".ui.forgot.ForgotSuccessActivity">

    <!-- Success icon -->
    <ImageView
        android:id="@+id/iv_forgot_success_icon"
        android:layout_width="319dp"
        android:layout_height="323dp"
        android:contentDescription="@null"
        android:src="@drawable/forgot_success"
        app:layout_constraintBottom_toTopOf="@id/tv_forgot_success_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_forgot_success_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="start"
        android:text="@string/label_forgot_success_title"
        android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
        android:textColor="#478831"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_forgot_success_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_forgot_success_icon" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_forgot_success_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_extralight"
        android:gravity="start"
        android:text="@string/label_forgot_success_subtitle"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/cv_forgot_success_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_forgot_success_title" />

    <!-- Back to Login Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_forgot_success_login"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_forgot_success_subtitle">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_forgot_success_login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_back_to_login"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>