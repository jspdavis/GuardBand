<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign-up Step 1 of 3 — Account (email + password + confirm).

    Credentials are collected here but the Firebase account is NOT created
    until the final Consent screen, so abandoning the wizard leaves nothing
    behind. See SignUpAccountActivity.
-->
<!-- DESIGN: Jul -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.GuardBand.SignUpStep"
    tools:context=".ui.signup.SignUpAccountActivity">

    <include
        android:id="@+id/header_signup_account"
        layout="@layout/view_signup_step_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_signup_account_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_signup_account_title"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_signup_account" />

    <TextView
        android:id="@+id/tv_signup_account_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_signup_account_subtitle"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_account_title" />

    <!-- Email -->
    <TextView
        android:id="@+id/tv_signup_email_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_field_email"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpFieldLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_account_subtitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_signup_email"
        style="@style/Widget.GuardBand.SignUpInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_email_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password -->
    <TextView
        android:id="@+id/tv_signup_password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_field_password"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpFieldLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_signup_email" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_signup_password"
        style="@style/Widget.GuardBand.SignUpInput"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_password_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm password -->
    <TextView
        android:id="@+id/tv_signup_confirm_password_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_field_confirm_password"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpFieldLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_signup_password" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_signup_confirm_password"
        style="@style/Widget.GuardBand.SignUpInput"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_confirm_password_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btn_signup_account_next"
        style="@style/Widget.GuardBand.SignUpContinue"
        android:text="@string/btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_signup_confirm_password" />

    <ProgressBar
        android:id="@+id/progress_signup_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_signup_account_next"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
