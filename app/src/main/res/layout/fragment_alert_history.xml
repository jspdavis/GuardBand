<?xml version="1.0" encoding="utf-8"?>
<!-- Alert history: current status card above the full incident history.
     A pushed screen in the Home host, opened from See all on Track's
     recent-alerts panel; it was the Alert tab until 2026-10-19.
     Spacing, type and colour are placeholders on theme tokens. -->
<!-- DESIGN: Jul -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.alert.AlertHistoryFragment">

    <!-- ── Top bar: back arrow + title (a pushed screen, not a tab) ────────── -->

    <LinearLayout
        android:id="@+id/ll_alert_history_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_alert_history_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_alert_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_alert_title"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ── Non-Scrollable Header Container (Progress & Errors) ──────────── -->

    <LinearLayout
        android:id="@+id/ll_alert_top_status_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_alert_history_top_bar">

        <ProgressBar
            android:id="@+id/alert_progress"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateDrawable="@drawable/bg_spinner_gradient"
            android:visibility="gone"
            tools:visibility="gone" />

        <LinearLayout
            android:id="@+id/alert_error_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/alert_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                android:textColor="@color/error_red"
                tools:text="Couldn't reach your band. Check your connection." />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_alert_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardMaxElevation="8dp">

                <Button
                    android:id="@+id/alert_retry_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_retry_gradient"
                    android:fontFamily="@font/poppins_extralight"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/btn_alert_retry"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp" />

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>

    <!-- ── Scrollable Body Content (Current Status & History) ────────────── -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_alert_top_status_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- ── Current status (D2: newest non-tracking alert) ────────────────── -->

            <TextView
                android:id="@+id/tv_alert_latest_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_alert_latest"
                android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alert_latest_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                tools:visibility="visible">

                <!-- The same shape as an item_alert.xml row, bound by the same
                     AlertCardViews, with its own ids and a slightly larger
                     badge. DESIGN: Jul -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/alert_latest_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_alert_type_badge"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        tools:backgroundTint="#29D32F2F"
                        tools:src="@drawable/ic_alert_panic"
                        tools:tint="@color/alert_panic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/alert_latest_type"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                                android:textColor="@color/text_primary"
                                tools:text="Panic" />

                            <TextView
                                android:id="@+id/alert_latest_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                                android:textColor="@color/text_secondary"
                                tools:text="5 min ago" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/alert_latest_place_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="2dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_map_pin"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/alert_latest_location"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                                android:textColor="@color/text_primary"
                                tools:text="Osmeña Boulevard, Capitol Site, Cebu City" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/alert_latest_battery_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/alert_latest_battery_icon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                tools:src="@drawable/ic_battery_mid"
                                tools:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/alert_latest_battery"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                                android:textColor="@color/text_secondary"
                                tools:text="64%" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nothing to show, and why (band silent / only tracking / unreadable) -->
            <TextView
                android:id="@+id/alert_empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:text="No alerts from your band yet."
                tools:visibility="visible" />

            <!-- ── History (FR-08) ───────────────────────────────────────────────── -->

            <TextView
                android:id="@+id/tv_alert_history_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_alert_history"
                android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
                android:textColor="@color/text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/alert_history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_alert" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>