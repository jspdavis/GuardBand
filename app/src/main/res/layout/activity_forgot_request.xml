<?xml version="1.0" encoding="utf-8"?>
<!--
  Forget Password: ask for a reset link, then wait for the email.
  One screen, two faces. The "check your email" half used to be a second
  Activity; it became a state when Resend arrived, because resending needs the
  address and only this screen has it.
  Endpoints only. DESIGN: Jul owns spacing, typography and colour here.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:padding="24dp"
    tools:context=".ui.forgot.ForgotRequestActivity">

    <ImageButton
        android:id="@+id/ib_forgot_request_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <!-- Container centering original content vertically -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ib_forgot_request_back"
        app:layout_constraintVertical_bias="0.35">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_forgot_request_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/label_forgot_request_title"
            android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
            android:textColor="@color/brand_green"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_forgot_request_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_extralight"
            android:text="@string/label_forgot_request_subtitle"
            android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
            android:textColor="@color/text_secondary" />

        <!-- Email input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_forgot_request_email"
            style="@style/Widget.GuardBand.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/hint_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_forgot_request_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_extralight"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Request / Resend button with Figma gradient and drop shadow -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_forgot_request_send"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="5dp"
            app:cardMaxElevation="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_forgot_request_send"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_signup_continue"
                android:fontFamily="@font/poppins_extralight"
                android:gravity="center"
                android:text="@string/btn_request_reset_link"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

        </androidx.cardview.widget.CardView>

        <!-- Cancel button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_forgot_request_cancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">

            <Button
                android:id="@+id/btn_forgot_request_cancel"
                style="@style/Widget.GuardBand.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_extralight"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                app:cornerRadius="28dp" />

        </androidx.cardview.widget.CardView>

        <!-- Progress indicator (exact original view attributes preserved) -->
        <ProgressBar
            android:id="@+id/progress_forgot_request"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/cd_forgot_request_progress"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>