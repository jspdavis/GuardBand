<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign-up Step 2 of 3 — Name (first + last).

    Same design as it had; the shared pieces now come from
    view_signup_step_header.xml and the Widget/TextAppearance.GuardBand.SignUp*
    styles, so a restyle happens in one place instead of four layouts.
-->
<!-- DESIGN: Jul -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.GuardBand.SignUpStep"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.signup.SignUpNameActivity">

    <include
        android:id="@+id/header_signup_name"
        layout="@layout/view_signup_step_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title (Semi-bold bold green matching sign-up theme) -->
    <TextView
        android:id="@+id/tv_signup_name_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/label_signup_name_title"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpTitle"
        android:textColor="@color/brand_green"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_signup_name" />

    <TextView
        android:id="@+id/tv_signup_name_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_extralight"
        android:text="@string/label_signup_name_subtitle"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_name_title" />

    <!-- First name -->
    <TextView
        android:id="@+id/tv_signup_first_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_extralight"
        android:text="@string/label_field_first_name"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpFieldLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_name_subtitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_signup_first_name"
        style="@style/Widget.GuardBand.SignUpInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_first_name_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_first_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extralight"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Last name -->
    <TextView
        android:id="@+id/tv_signup_last_name_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_extralight"
        android:text="@string/label_field_last_name"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpFieldLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_signup_first_name" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_signup_last_name"
        style="@style/Widget.GuardBand.SignUpInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_signup_last_name_label">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_last_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extralight"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Continue Button Container with CardView Drop Shadow & Gradient -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_signup_name_next"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_signup_last_name">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_signup_name_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_continue"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <ProgressBar
        android:id="@+id/progress_signup_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_signup_name_next"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>