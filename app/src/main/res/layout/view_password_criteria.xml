<?xml version="1.0" encoding="utf-8"?>
<!--
  The password criteria list, as an include so more than one screen can show
  the same rules. New Credentials uses it today; sign-up and a future change
  password screen are the other candidates.
  PasswordCriteriaList binds it and tints each row. Add a row here and a field
  to PasswordCriteria together, never a rule written out in a layout.
  Endpoints only. DESIGN: Jul owns spacing, typography and colour here.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_password_criteria_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_password_criteria_title"
        android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
        android:textColor="@color/text_secondary" />

    <!-- DESIGN: Jul -->
    <TextView
        android:id="@+id/tv_password_rule_length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_check_circle"
        android:text="@string/label_password_rule_length"
        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
        tools:textColor="@color/rule_met" />

    <TextView
        android:id="@+id/tv_password_rule_match"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_check_circle"
        android:text="@string/label_password_rule_match"
        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
        tools:textColor="@color/rule_unmet" />

</LinearLayout>
