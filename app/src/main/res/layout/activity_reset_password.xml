<?xml version="1.0" encoding="utf-8"?>
<!--
  New Credentials: the in-app end of a password reset, reached by the App Link
  in Firebase's reset email.
  Four faces, switched by ResetPasswordStage: a spinner while the code is
  checked, this form, a dead-link panel, and on its way to Login.
  Endpoints only. DESIGN: Jul owns spacing, typography and colour here.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:padding="24dp"
    tools:context=".ui.reset.ResetPasswordActivity">

    <ImageButton
        android:id="@+id/ib_reset_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <TextView
        android:id="@+id/tv_reset_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/label_reset_title"
        android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
        android:textColor="#478831"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ib_reset_back" />

    <!-- Read-only: which account is being changed. Set from the code check. -->
    <TextView
        android:id="@+id/tv_reset_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_extralight"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reset_title"
        tools:text="Resetting password for alex@guardband.com" />

    <!-- ── The form ──────────────────────────────────────────────────────── -->

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_reset_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="include_reset_criteria,til_reset_password,til_reset_confirm,cv_reset_submit,cv_reset_cancel"
        tools:visibility="visible" />

    <include
        android:id="@+id/include_reset_criteria"
        layout="@layout/view_password_criteria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reset_email" />

    <!-- DESIGN: Jul -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_reset_password"
        style="@style/Widget.GuardBand.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/hint_new_password"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_reset_criteria">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_reset_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extralight"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- DESIGN: Jul -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_reset_confirm"
        style="@style/Widget.GuardBand.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_confirm_password"
        app:endIconMode="password_toggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_reset_password">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_reset_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extralight"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Submit Button styled like Log In Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_reset_submit"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_reset_confirm">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_reset_submit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_submit"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <!-- Cancel Button with Black Gradient bg_retry_gradient -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_reset_cancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_reset_submit">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_reset_cancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_retry_gradient"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <!-- ── Dead link ───────────────────────────────────────────────────────── -->

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_reset_dead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_reset_message,btn_reset_request_new" />

    <TextView
        android:id="@+id/tv_reset_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_extralight"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/error_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reset_email"
        tools:text="This reset link has expired. Request a new one to continue." />

    <Button
        android:id="@+id/btn_reset_request_new"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_reset_request_new"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reset_message" />

    <Button
        android:id="@+id/btn_reset_retry_verify"
        style="@style/Widget.GuardBand.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_retry"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_reset_request_new" />

</androidx.constraintlayout.widget.ConstraintLayout>