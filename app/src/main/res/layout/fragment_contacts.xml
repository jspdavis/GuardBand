<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    tools:context=".ui.contacts.ContactsFragment">

    <!-- ── Top Action Buttons (Settings & Notifications) ────────────────── -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_profile_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/cd_open_settings"
        android:src="@drawable/ic_settings"
        app:backgroundTint="@color/white"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="#478831" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_alert_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/cd_open_notifications"
        android:src="@drawable/ic_notifications"
        app:backgroundTint="@color/white"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="#478831" />

    <!-- ── Scrollable Body Content (Header, Min Notice & RecyclerView) ─── -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/cv_add_contact_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ib_profile_settings">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_contacts_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_contacts_title"
                android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
                android:textColor="@color/text_primary" />

            <!-- DESIGN: Jul -->
            <TextView
                android:id="@+id/contacts_min_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:text="1 of 3 minimum"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progress_contacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_contacts_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_contacts_empty"
                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_contact" />

        </LinearLayout>
    </ScrollView>

    <!-- ── Fixed Add Contact Button ─────────────────────────────────────── -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_add_contact_container"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/include_nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/contacts_add_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:text="@string/btn_add_contact"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@null"
            app:strokeWidth="0dp" />

    </androidx.cardview.widget.CardView>

    <!-- ── Nav Bar Included from activity_home ──────────────────────────── -->

    <include
        android:id="@+id/include_nav_bar"
        layout="@layout/activity_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>