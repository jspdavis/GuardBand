<?xml version="1.0" encoding="utf-8"?>
<!--
    Alert notifications (opened from its row in Settings): the switch, what it
    does, the phone's notification page when GuardBand is blocked, and the
    battery page while it is on. White, with the shared top bar, like
    Settings and Account information.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    tools:context=".ui.notifications.AlertNotificationsActivity">

    <!-- Top bar: back arrow + title. Matches fragment_settings.xml's. -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_alert_notifications_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_alert_notifications_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_alert_notifications_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_alert_notifications"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_alert_notifications_top_bar">

        <!-- The same geometry as Settings' rows, so the switch sits where its
             row did: the help, the button and the battery row line up under
             the switch's text (12 + 36 + 12 + 16 dp). DESIGN: Jul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_settings_icon_badge"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/white" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_alert_notifications"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_extralight"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:text="@string/label_alert_notifications_switch"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_alert_notifications_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_marginBottom="12dp"
                android:text="@string/label_settings_alert_notifications_help"
                android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                android:textColor="@color/text_secondary" />

            <!-- Only while the phone blocks GuardBand's notifications. -->
            <Button
                android:id="@+id/btn_alert_notifications_system_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_settings_notification_settings"
                android:textAllCaps="false"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Only while it is on. Opens a system page, not a screen of the
                 app, so the row has no chevron. -->
            <LinearLayout
                android:id="@+id/ll_alert_notifications_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    style="@style/Widget.GuardBand.SettingsDivider"
                    android:layout_marginStart="64dp" />

                <TextView
                    android:id="@+id/tv_alert_notifications_battery"
                    style="@style/Widget.GuardBand.SettingsRow.Action"
                    android:layout_marginStart="48dp"
                    android:fontFamily="@font/poppins_extralight"
                    android:text="@string/label_settings_alert_battery" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
