<?xml version="1.0" encoding="utf-8"?>
<!--
  Re-authentication before Delete account. Firebase refuses delete() on a
  session that has been sitting around, and a destructive action should ask
  anyway. Only the password is collected; the email comes from the live
  session inside the repository, never from a field.
  Endpoints only. DESIGN: Jul owns spacing, typography and colour here.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/tv_reauth_password_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/dialog_reauth_password_message"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary" />

    <!-- DESIGN: Jul -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_reauth_password"
        style="@style/Widget.GuardBand.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_reauth_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
