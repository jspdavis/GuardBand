<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.notifications.NotificationsFragment">

    <!-- ── Top Action Buttons (Settings & Notifications) ────────────────── -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_notifications_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/cd_open_settings"
        android:src="@drawable/ic_settings"
        app:backgroundTint="@color/white"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="#478831" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ib_notifications_bell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/cd_open_notifications"
        android:src="@drawable/ic_notifications"
        app:backgroundTint="@color/white"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.Circle"
        app:tint="#478831" />

    <!-- ── Empty inbox (placeholder) ────────────────────────────────────── -->

    <TextView
        android:id="@+id/tv_notifications_empty"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:drawablePadding="12dp"
        android:gravity="center"
        android:text="@string/label_notifications_empty"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:drawableTint="@color/text_hint"
        app:drawableTopCompat="@drawable/ic_notifications"
        app:layout_constraintBottom_toTopOf="@id/include_nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ib_notifications_settings" />

    <!-- ── Nav Bar Included from activity_home ──────────────────────────── -->

    <include
        android:id="@+id/include_nav_bar"
        layout="@layout/activity_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>