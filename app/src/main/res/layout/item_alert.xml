<?xml version="1.0" encoding="utf-8"?>
<!--
    One alert: a row of the Alert history list and of Track's recent-alerts panel,
    bound by ui/alert/AlertCardViews (Alert history's latest card is the same
    shape, with its own ids).

    The type's symbol on a pale circle of its colour, then the type and time,
    the place with a pin, and the battery with its level. A panic's card is
    pale red with a red outline instead of grey; AlertCardViews sets the fill,
    the outline and every tint in code.
    DESIGN: Jul (spacing, sizes, the panic colours and the badge's shade)
-->
<!-- Customized alert card container styling and badge layout by ishi -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- The type's symbol on its badge, tinted in code by AlertCardViews - modernized badge layout by ishi -->
        <ImageView
            android:id="@+id/iv_item_alert_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_alert_type_badge"
            android:importantForAccessibility="no"
            android:padding="10dp"
            tools:backgroundTint="#29D32F2F"
            tools:src="@drawable/ic_alert_panic"
            tools:tint="@color/alert_panic" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_alert_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:textAppearance="@style/TextAppearance.GuardBand.TitleSmall"
                    android:textColor="@color/text_primary"
                    tools:text="Panic" />

                <TextView
                    android:id="@+id/tv_item_alert_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                    android:textColor="@color/text_secondary"
                    tools:text="5 min ago" />
            </LinearLayout>

            <!-- The place, or its coordinates until a name arrives. Up to two
                 lines; the pin stays beside the first. -->
            <LinearLayout
                android:id="@+id/ll_item_alert_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_item_alert_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                    android:textColor="@color/text_primary"
                    tools:text="Osmeña Boulevard, Capitol Site, Cebu City" />
            </LinearLayout>

            <!-- The battery: a symbol for its level (AlertFormatting.batteryIcon),
                 orange at or below FR-11's 20%, and the percentage. -->
            <LinearLayout
                android:id="@+id/ll_item_alert_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_item_alert_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_battery_mid"
                    tools:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_item_alert_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                    android:textColor="@color/text_secondary"
                    tools:text="64%" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
