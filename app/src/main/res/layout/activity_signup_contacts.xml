<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign-up Step 3 of 3 — Emergency contacts.

    Contacts are staged here and written by the Consent screen, so there is no
    progress bar and no retry: nothing on this screen can fail.

    Rows reuse item_contact.xml and the editor reuses dialog_contact_editor.xml,
    the same ones the Contacts tab uses.
-->
<!-- DESIGN: Jul -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.GuardBand.SignUpStep"
    android:orientation="vertical"
    tools:context=".ui.signup.SignUpContactsActivity">

    <include
        android:id="@+id/header_signup_contacts"
        layout="@layout/view_signup_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_signup_contacts_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_signup_contacts_title"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpTitle" />

    <TextView
        android:id="@+id/tv_signup_contacts_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_signup_contacts_subtitle"
        android:textAppearance="@style/TextAppearance.GuardBand.SignUpSubtitle" />

    <!-- "n of 3 minimum": a nudge, not a gate. Sign-up requires one. -->
    <TextView
        android:id="@+id/signup_contacts_min_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
        android:textColor="@color/text_secondary"
        tools:text="0 of 3 minimum" />

    <TextView
        android:id="@+id/tv_signup_contacts_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_signup_contacts_empty"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_signup_contacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_contact" />

    <!-- Add Contact Button (Retains outlined style with 56dp height and 28dp pill radius) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <Button
            android:id="@+id/btn_signup_contacts_add"
            style="@style/Widget.GuardBand.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins_extralight"
            android:text="@string/btn_signup_add_contact"
            android:textAllCaps="false"
            app:cornerRadius="28dp" />

    </androidx.cardview.widget.CardView>

    <!-- Continue Button (Green linear gradient bg_signup_continue) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_signup_contacts_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_continue"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

</LinearLayout>