<?xml version="1.0" encoding="utf-8"?>
<!-- Track tab's recent-alerts sheet, included by fragment_track.xml as a
     BottomSheetBehavior child of its CoordinatorLayout, and bound by
     ui/track/RecentAlertsPanel. The rows are item_alert.xml, the same rows
     the Alert history screen shows.

     Clickable so a tap on the sheet stays on the sheet instead of reaching
     the map underneath; drags are taken by the sheet's behavior. Not
     important for accessibility itself, so TalkBack reads its children
     rather than announcing a control with no action. Expanding and
     collapsing for TalkBack is the drag handle's job.
     DESIGN: Jul (white sheet, top corners rounded, as a placeholder) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    android:importantForAccessibility="no"
    app:cardBackgroundColor="@color/surface_bg"
    app:cardElevation="8dp"
    app:rippleColor="@android:color/transparent"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.GuardBand.SheetTop"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!-- Material's drag handle: the visible grip, and the accessible way
             to expand or collapse (it is a button TalkBack can activate). -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/track_recent_alerts_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header: title, and See all to the full history. -->
        <LinearLayout
            android:id="@+id/ll_track_recent_alerts_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_track_recent_alerts_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/label_track_recent_alerts"
                android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btn_track_recent_alerts_see_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_track_recent_alerts_see_all"
                android:text="@string/btn_track_recent_alerts_see_all"
                android:textColor="@color/brand_green" />
        </LinearLayout>

        <!-- Body: one of spinner, error, empty or the rows. -->
        <LinearLayout
            android:id="@+id/ll_track_recent_alerts_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/track_recent_alerts_progress"
                style="@style/Widget.AppCompat.ProgressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/cd_track_recent_alerts_loading"
                android:indeterminateDrawable="@drawable/bg_spinner_gradient"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/track_recent_alerts_error_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/track_recent_alerts_error_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                    android:textColor="@color/error_red"
                    tools:text="Couldn't reach your band. Check your connection." />

                <Button
                    android:id="@+id/track_recent_alerts_retry_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_alert_retry"
                    android:textColor="@color/brand_green" />
            </LinearLayout>

            <!-- Nothing to show, and why: the Alert ViewModel's own wording. -->
            <TextView
                android:id="@+id/track_recent_alerts_empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                tools:text="No alerts from your band yet."
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/track_recent_alerts_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_alert" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
