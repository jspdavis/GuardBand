<?xml version="1.0" encoding="utf-8"?>
<!--
    Verify your email: the gate a password account meets instead of the tabs
    until its address is verified. One primary action (I have verified), then
    Resend, then the two ways out that do not need the inbox.
    DESIGN: Jul owns spacing, typography and colour here.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:padding="24dp"
    tools:context=".ui.verify.VerifyRequiredActivity">

    <TextView
        android:id="@+id/tv_verify_required_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/label_verify_required_title"
        android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
        android:textColor="@color/brand_green"
        app:layout_constraintBottom_toTopOf="@id/tv_verify_required_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/tv_verify_required_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_extralight"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/progress_verify_required"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_verify_required_title"
        tools:text="We sent a link to alex@gmail.com." />

    <ProgressBar
        android:id="@+id/progress_verify_required"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_verify_required_progress"
        android:indeterminateDrawable="@drawable/bg_spinner_gradient"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/cv_verify_required_check"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_verify_required_message"
        tools:visibility="visible" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_verify_required_check"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:cardMaxElevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/btn_verify_required_resend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_verify_required">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_required_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_signup_continue"
            android:fontFamily="@font/poppins_extralight"
            android:gravity="center"
            android:text="@string/btn_verify_required_check"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_verify_required_resend"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_account_resend"
        android:textAllCaps="false"
        app:layout_constraintBottom_toTopOf="@id/btn_verify_required_log_out"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_verify_required_check" />

    <Button
        android:id="@+id/btn_verify_required_log_out"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_logout"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/btn_verify_required_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_verify_required_resend" />

    <Button
        android:id="@+id/btn_verify_required_delete"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_verify_required_delete"
        android:textAllCaps="false"
        android:textColor="@color/error_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_verify_required_log_out" />

</androidx.constraintlayout.widget.ConstraintLayout>
