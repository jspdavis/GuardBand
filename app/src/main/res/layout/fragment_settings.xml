<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.settings.SettingsFragment">

    <!-- ── Top bar: back arrow + title (a pushed screen, not a tab) ────────── -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_settings_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_title"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ── Scrollable Body Content ───────────────────────────────────────── -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_settings_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ── Rows (Figma Green Icon Badges) ───────────────────────── -->
            <!-- Flat and the same white as the screen, so the rows read as part
                 of it rather than as a separate card. DESIGN: Jul -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- Account Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:padding="8dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_account"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_extralight"
                            android:text="@string/label_settings_account" />
                    </LinearLayout>

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <!-- Change Password Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:padding="8dp"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_change_password"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_extralight"
                            android:text="@string/label_settings_change_password" />
                    </LinearLayout>

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <!-- Alert notifications: a switch, its help text, the
                         system page when blocked, and the battery row while
                         on. The help, the button and the battery row line up
                         under the switch's text (36 + 12 + 16 dp).
                         DESIGN: Jul -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/white" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sw_settings_alert_notifications"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_extralight"
                            android:minHeight="56dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/label_settings_alert_notifications"
                            android:textAppearance="@style/TextAppearance.GuardBand.BodyLarge"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_settings_alert_notifications_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="64dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/label_settings_alert_notifications_help"
                        android:textAppearance="@style/TextAppearance.GuardBand.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <Button
                        android:id="@+id/btn_settings_notification_settings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="52dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/btn_settings_notification_settings"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_settings_alert_battery"
                        style="@style/Widget.GuardBand.SettingsRow"
                        android:layout_marginStart="48dp"
                        android:fontFamily="@font/poppins_extralight"
                        android:text="@string/label_settings_alert_battery"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <!-- Privacy Notice Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:padding="8dp"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_privacy_notice"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_extralight"
                            android:text="@string/label_settings_privacy_notice" />
                    </LinearLayout>

                    <View style="@style/Widget.GuardBand.SettingsDivider" />

                    <!-- Changelog Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_history"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_changelog"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_extralight"
                            android:text="@string/label_settings_changelog" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Log Out Button ────────────────────────────────────────────────── -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="5dp"
                app:cardMaxElevation="10dp">

                <Button
                    android:id="@+id/btn_settings_logout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_signup_continue"
                    android:fontFamily="@font/poppins_extralight"
                    android:text="@string/btn_logout"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>