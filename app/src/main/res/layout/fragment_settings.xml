<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ui.settings.SettingsFragment">

    <!-- ── Top bar: back arrow + title (a pushed screen, not a tab) ────────── -->
    <!-- DESIGN: Jul -->

    <LinearLayout
        android:id="@+id/ll_settings_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ib_settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_title"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ── Scrollable Body Content ───────────────────────────────────────── -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_settings_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ── Rows (Figma Green Icon Badges) ───────────────────────── -->
            <!-- Flat and the same white as the screen, so the rows read as part
                 of it rather than as a separate card. DESIGN: Jul -->

            <!-- Settings Card Container. Edge to edge: no side margins and square
                 corners, so each row and its ripple reach the screen's sides. The
                 rows' own 16dp padding keeps the icons off the edge. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_bg"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Account Row -->
                    <LinearLayout
                        android:id="@+id/row_settings_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_account"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_account"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_account" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginEnd="16dp" />

                    <!-- Alert notifications Row: opens its own screen
                         (AlertNotificationsActivity), which holds the switch. -->
                    <LinearLayout
                        android:id="@+id/row_settings_alert_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_alert_notifications"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_alert_notifications"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_alert_notifications" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginEnd="16dp" />

                    <!-- Display Row: the theme (DisplayActivity). -->
                    <LinearLayout
                        android:id="@+id/row_settings_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_display"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_display"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_display"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_display" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginEnd="16dp" />

                    <!-- Device information Row: a placeholder, for the band
                         once pairing exists. -->
                    <LinearLayout
                        android:id="@+id/row_settings_device_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_device_info"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_watch"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_device_info"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_device_info" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginEnd="16dp" />

                    <!-- Changelog Row -->
                    <LinearLayout
                        android:id="@+id/row_settings_changelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_changelog"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_history"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_changelog"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_changelog" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.GuardBand.SettingsDivider"
                        android:layout_marginEnd="16dp" />

                    <!-- About Row: the app's version and the Privacy Notice
                         (AboutActivity). -->
                    <LinearLayout
                        android:id="@+id/row_settings_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/label_settings_about"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_settings_icon_badge"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_settings_about"
                            style="@style/Widget.GuardBand.SettingsRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:clickable="false"
                            android:focusable="false"
                            android:fontFamily="@font/poppins_extralight"
                            android:importantForAccessibility="no"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/label_settings_about" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Log Out Button ────────────────────────────────────────────────── -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="5dp"
                app:cardMaxElevation="10dp">

                <Button
                    android:id="@+id/btn_settings_logout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_signup_continue"
                    android:fontFamily="@font/poppins_extralight"
                    android:text="@string/btn_logout"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>