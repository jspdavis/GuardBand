<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_muted"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    tools:context=".ui.settings.SettingsFragment">

    <!-- ── Top bar ───────────────────────────────────────────────────────── -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/ib_settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/label_settings_title"
            android:textAppearance="@style/TextAppearance.GuardBand.TitleLarge"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- ── Rows (placeholders) ───────────────────────────────────────────── -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_settings_account"
                style="@style/Widget.GuardBand.SettingsRow"
                android:text="@string/label_settings_account" />

            <View style="@style/Widget.GuardBand.SettingsDivider" />

            <TextView
                android:id="@+id/tv_settings_change_password"
                style="@style/Widget.GuardBand.SettingsRow"
                android:text="@string/label_settings_change_password" />

            <View style="@style/Widget.GuardBand.SettingsDivider" />

            <TextView
                android:id="@+id/tv_settings_notifications"
                style="@style/Widget.GuardBand.SettingsRow"
                android:text="@string/label_settings_notifications" />

            <View style="@style/Widget.GuardBand.SettingsDivider" />

            <TextView
                android:id="@+id/tv_settings_privacy"
                style="@style/Widget.GuardBand.SettingsRow"
                android:text="@string/label_settings_privacy" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Log Out (moved from the old Dashboard) ────────────────────────── -->

    <Button
        android:id="@+id/btn_settings_logout"
        style="@style/Widget.GuardBand.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/btn_logout" />

    <!-- ── Delete account ────────────────────────────────────────────────────
         Its own card, well below Log Out, so the irreversible action is not
         one mis-tap away from the reversible one. The banner above it is
         state, not a dialog: a failure that left the data deleted and the
         sign-in alive must stay visible until it is finished, so it cannot be
         dismissed into nothing.
    -->

    <!-- DESIGN: Jul -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_settings_delete_failure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/error_red"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_settings_delete_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
                android:textColor="@color/error_red"
                tools:text="Your data is deleted, but your sign-in is still active. Tap Retry to finish." />

            <Button
                android:id="@+id/btn_settings_delete_retry"
                style="@style/Widget.GuardBand.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/btn_retry" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:id="@+id/tv_settings_delete_account"
            style="@style/Widget.GuardBand.SettingsRow.Destructive"
            android:text="@string/label_settings_delete_account" />
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/progress_settings_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_delete_account_progress"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
