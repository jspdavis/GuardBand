<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    tools:context=".ui.alert.AlertFragment">

    <TextView
        android:id="@+id/tv_alert_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_alert_title"
        android:textAppearance="@style/TextAppearance.GuardBand.HeadlineSmall"
        android:textColor="@color/text_primary" />

    <ProgressBar
        android:id="@+id/progress_alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- ── Current status (latest alert) ─────────────────────────────────── -->

    <TextView
        android:id="@+id/tv_alert_latest_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/label_alert_latest"
        android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
        android:textColor="@color/text_secondary" />

    <include
        android:id="@+id/include_alert_latest"
        layout="@layout/item_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_alert_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_alert_none"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- ── History (FR-08) ───────────────────────────────────────────────── -->

    <TextView
        android:id="@+id/tv_alert_history_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/label_alert_history"
        android:textAppearance="@style/TextAppearance.GuardBand.LabelLarge"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tv_alert_history_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_alert_history_empty"
        android:textAppearance="@style/TextAppearance.GuardBand.BodyMedium"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_alert_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_alert" />

</LinearLayout>
