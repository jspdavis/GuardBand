<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tab row: MaterialButtonToggleGroup for segmented tab selection -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_invite_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btn_invite_tab_enter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_invite_tab_enter"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_invite_tab_enter" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_invite_tab_share"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_invite_tab_share" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Panel: enter a code (watcher side) -->
    <LinearLayout
        android:id="@+id/panel_invite_enter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_invite_code">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_invite_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="6" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_invite_redeem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_invite_enter_code" />

    </LinearLayout>

    <!-- Panel: generate and share a code (wearer side) -->
    <LinearLayout
        android:id="@+id/panel_invite_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_invite_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_invite_generate_code" />

        <LinearLayout
            android:id="@+id/layout_invite_code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_invite_generated_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:letterSpacing="0.15"
                android:padding="8dp"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/brand_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_invite_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_invite_expires"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite_copy"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_invite_copy_code"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart" />

        </LinearLayout>

    </LinearLayout>

    <!-- Progress and status (shared) -->
    <ProgressBar
        android:id="@+id/progress_invite"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_invite_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

</LinearLayout>
