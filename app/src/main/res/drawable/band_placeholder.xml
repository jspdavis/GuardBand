<?xml version="1.0" encoding="utf-8"?>
<!--
    The band viewer's placeholder: a plain, neutral band seen from the front
    (strap, body, display strip, three round buttons), drawn in theme colours
    so it follows dark mode. Shown while app/src/main/assets/band_turntable/
    holds no frames, and for a frame that fails to load.
    REPLACE by dropping the rendered frames into that folder
    (docs/band-viewer.md); this file can then stay as the fallback.
    DESIGN: Jul
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="144dp"
    android:viewportWidth="200"
    android:viewportHeight="240">

    <!-- Strap, top and bottom -->
    <path
        android:fillColor="@color/surface_muted"
        android:pathData="M72,0 L128,0 Q134,0 134,6 L134,74 L66,74 L66,6 Q66,0 72,0 Z" />
    <path
        android:fillColor="@color/surface_muted"
        android:pathData="M66,166 L134,166 L134,234 Q134,240 128,240 L72,240 Q66,240 66,234 Z" />

    <!-- Body -->
    <path
        android:fillColor="@color/text_secondary"
        android:pathData="M74,56 L126,56 Q150,56 150,80 L150,160 Q150,184 126,184 L74,184 Q50,184 50,160 L50,80 Q50,56 74,56 Z" />

    <!-- Display strip -->
    <path
        android:fillColor="@color/brand_green"
        android:pathData="M74,82 L126,82 Q130,82 130,86 L130,108 Q130,112 126,112 L74,112 Q70,112 70,108 L70,86 Q70,82 74,82 Z" />

    <!-- Three round buttons -->
    <path
        android:fillColor="@color/surface_muted"
        android:pathData="M74,146 m-8,0 a8,8 0,1 1,16 0 a8,8 0,1 1,-16 0 Z" />
    <path
        android:fillColor="@color/surface_muted"
        android:pathData="M100,146 m-8,0 a8,8 0,1 1,16 0 a8,8 0,1 1,-16 0 Z" />
    <path
        android:fillColor="@color/surface_muted"
        android:pathData="M126,146 m-8,0 a8,8 0,1 1,16 0 a8,8 0,1 1,-16 0 Z" />
</vector>
