<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 28dp radius matching the 56dp height pill shape -->
    <corners android:radius="28dp" />

    <!-- Left-to-right linear gradient (angle="0") with your exact Figma stops -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/brand_green"
        android:centerColor="#356824"
        android:centerX="0.50"
        android:endColor="#234817" />

</shape>