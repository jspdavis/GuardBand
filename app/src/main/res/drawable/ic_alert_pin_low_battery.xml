<?xml version="1.0" encoding="utf-8"?>
<!-- A LOW_BATTERY alert's pin on the Track map: a 24 x 32 dp map pin filled with
     alert_low_battery (lighter in dark mode, from values-night), a white ring like the
     band's face marker so it reads on light tiles and dark ones, and the
     type's own symbol (the alert rows' icon) in white in its head. Its tip,
     (12, 30) of the 24 x 32 viewport, is the anchor (TrackFragment.PIN_ANCHOR_V). Clearly smaller
     than the face marker's 58 x 66 dp, which is drawn on top. DESIGN: Jul -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="32dp"
    android:viewportWidth="24"
    android:viewportHeight="32">
    <path
        android:fillColor="@color/alert_low_battery"
        android:pathData="M12,30L3.68,17.56A10,10 0,1 1,20.32,17.56Z"
        android:strokeWidth="1.5"
        android:strokeColor="@color/white"
        android:strokeLineJoin="round" />
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="4.8"
        android:translateY="4.8">
        <path
            android:fillColor="@color/white"
            android:pathData="M1,21h22L12,2 1,21zM13,18h-2v-2h2v2zM13,14h-2v-4h2v4z" />
    </group>
</vector>
