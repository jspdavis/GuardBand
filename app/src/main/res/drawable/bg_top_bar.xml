<?xml version="1.0" encoding="utf-8"?>
<!-- A pushed screen's top bar: white, with a 1dp divider-coloured line along
     its bottom edge, so the bar stays distinct on a white screen.
     Shared by every top bar; change the line here, not per layout.
     DESIGN: Jul -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/divider" />
        </shape>
    </item>

    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>

</layer-list>
