<?xml version="1.0" encoding="utf-8"?>
<!--
    GuardBand's launcher icon: logo_mark on white.
    The foreground PNGs are generated from drawable-nodpi/logo_mark.png, with
    the logo kept inside the 66dp safe zone so no launcher mask clips it.
    No monochrome layer: themed icons (Android 13+) are drawn from a layer's
    transparency, and the logo is an opaque picture on white, so it would
    theme as a plain square. Without one, Android shows the colour icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
