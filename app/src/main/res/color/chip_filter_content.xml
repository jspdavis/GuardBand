<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts filter chip text and tick: white on the green selected chip
     (black on white in dark mode), the primary text colour otherwise.
     DESIGN: Jul -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/chip_filter_checked_content" android:state_checked="true" />
    <item android:color="@color/text_primary" />
</selector>
