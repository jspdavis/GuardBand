<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only additions, merged into the main manifest for debug builds.
    MockSenderActivity is a throwaway test harness that stands in for the
    wristband firmware; it gets its own launcher icon so a demo phone can
    open it without adb. Release builds contain neither the code nor the icon.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Debug-only location permissions for the mock sender.
        The sender stands in for the ESP32 + NEO-6M hardware and should report
        Phone A's own GPS fix instead of a hardcoded Cebu City position.

        These permissions are declared here, NOT in the main manifest, so:
          - Release builds contain no location permission.
          - The receiver app (HomeActivity and its tabs) never touches the
            phone's location — the band is the only source of position.
        See CLAUDE.md "Track and map" and "Mock sender" for the rationale.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application>

        <activity
            android:name=".ui.mocksender.MockSenderActivity"
            android:exported="true"
            android:label="@string/mock_sender_label"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
